datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum TripStatus {
  ON_TRIP
  COMPLETED
}

enum DispatchStatus {
  ON_TRIP
  AT_TERMINAL
}

enum VehicleState {
  FULL
  AVAILABLE
}

enum IncidentType {
  OVERCAPACITY
  OVERSPEEDING
}

enum IncidentStatus {
  PENDING
  APPROVED
  DISMISSED
}

enum IncidentTripStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  USER
  // Expand these based on your public.UserRole types
}

enum ViolationStatus {
  PENDING
  APPROVED
  DISMISSED
  // Expand these based on your public.ViolationStatus types
}

//////////////////////////////////////////////////////
// MODELS
//////////////////////////////////////////////////////

model bantai_users {
  id         String   @id @default(uuid()) @db.Uuid
  username   String   @unique
  email      String?  @unique
  first_name String
  last_name  String
  password   String
  role       UserRole
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp()
  updated_at DateTime @updatedAt @db.Timestamp()

  @@map("bantai_users")
}

model Operator {
  operator_id    String  @id @default(uuid()) @db.Uuid
  operator_name  String
  email          String  @unique
  contact_number String
  route_id       String? @default(uuid()) @db.Uuid

  drivers  Driver[]
  vehicles Vehicle[]
  users    Operator_User[]

  @@map("operator")
}

model Driver {
  driver_id   String @id @default(uuid()) @db.Uuid
  driver_name String
  operator_id String @db.Uuid

  operator Operator  @relation(fields: [operator_id], references: [operator_id])
  vehicles Vehicle[]

  @@map("driver")
}

model Operator_User {
  user_id        String    @id @default(uuid()) @db.Uuid
  operator_id    String    @db.Uuid
  username       String    @unique
  password_hash  String
  employee_name  String
  email          String    @unique
  contact_number String
  role           String
  created_at     DateTime? @default(now()) @db.Timestamp()

  operator Operator @relation(fields: [operator_id], references: [operator_id])

  @@map("operator_user")
}

model Route {
  route_id               String  @id @default(uuid()) @db.Uuid
  route_name             String
  terminal_latitude      Float?  // Prisma will map this to double precision
  terminal_longitude     Float?  // Prisma will map this to double precision
  terminal_radius_meters Int?    @default(65)

  vehicles Vehicle[]

  @@map("route")
}

model Vehicle {
  vehicle_id        String        @id @default(uuid()) @db.Uuid
  operator_id       String        @db.Uuid
  driver_id         String        @db.Uuid
  route_id          String        @db.Uuid
  vehicle_code      String
  plate_number      String
  sitting_capacity  Int
  standing_capacity Int
  speed_limit       Int
  vehicle_type      String?
  status            VehicleStatus @default(ACTIVE)

  operator Operator @relation(fields: [operator_id], references: [operator_id])
  driver   Driver   @relation(fields: [driver_id], references: [driver_id])
  route    Route    @relation(fields: [route_id], references: [route_id])

  trips                   Trip[]
  dispatchQueues          Dispatch_Queue[]
  statuses                Vehicle_Status[]
  etaRequests             ETA_Request[]
  incidents               Incident[]
  overcapacity_violations Overcapacity_Violations[]
  overspeeding_violations Overspeeding_Violations[]

  @@map("vehicle")
}

model Trip {
  trip_id              String     @id @default(uuid()) @db.Uuid
  vehicle_id           String?    @db.Uuid
  trip_number          Int?       @db.SmallInt
  start_trip_timestamp DateTime?  @default(now()) @db.Timestamptz()
  end_trip_timestamp   DateTime?  @db.Timestamptz()
  trip_status          String?    // Changed to String to match your check constraint, or use the TripStatus enum
  dispatch_type        String?

  vehicle Vehicle? @relation(fields: [vehicle_id], references: [vehicle_id])

  incidents   Incident[]
  etaRequests ETA_Request[]

  @@map("trip")
}

model Dispatch_Queue {
  queue_id        String         @id @default(uuid()) @db.Uuid
  vehicle_id      String         @db.Uuid
  position        Int
  status          DispatchStatus
  entry_timestamp DateTime

  vehicle Vehicle @relation(fields: [vehicle_id], references: [vehicle_id])

  @@map("dispatch_queue")
}

model Vehicle_Status {
  status_id                String       @id @default(uuid()) @db.Uuid
  vehicle_id               String       @db.Uuid
  standing_passenger_count Int
  sitting_passenger_count  Int
  vehicle_latitude         Float
  vehicle_longitude        Float
  vehicle_state            VehicleState
  timestamp                DateTime

  vehicle Vehicle @relation(fields: [vehicle_id], references: [vehicle_id])

  @@map("vehicle_status")
}

//////////////////////////////////////////////////////
// INCIDENT SYSTEM
//////////////////////////////////////////////////////

model Incident {
  incident_id          String             @id @default(uuid()) @db.Uuid
  vehicle_id           String?            @default(uuid()) @db.Uuid
  trip_id              String?            @db.Uuid
  incident_type        IncidentType[]     // PostgreSQL arrays are supported
  incident_status      IncidentStatus     @default(PENDING)
  incident_trip_status IncidentTripStatus @default(ACTIVE)
  timestamp            DateTime?          @default(now()) @db.Timestamptz()
  detected_at          DateTime?          @db.Timestamp()
  isActive             Boolean?

  trip    Trip?    @relation(fields: [trip_id], references: [trip_id])
  vehicle Vehicle? @relation(fields: [vehicle_id], references: [vehicle_id])

  overcapacityDetails Overcapacity_Violations?
  overspeedingDetails Overspeeding_Violations?

  @@map("incident")
}

model Overcapacity_Violations {
  overcapacity_id    String          @id @default(uuid()) @db.Uuid
  incident_id        String?         @unique @default(uuid()) @db.Uuid
  vehicle_id         String          @default(uuid()) @db.Uuid
  status             ViolationStatus @default(PENDING)
  remarks            String?
  detected_at        DateTime        @default(now()) @db.Timestamp()
  created_at         DateTime        @default(now()) @db.Timestamp()
  updated_at         DateTime        @default(now()) @updatedAt @db.Timestamp()
  image_url_front  String?
  image_url_rear   String?
  recorded_standing  BigInt?
  recorded_sitting   BigInt?
  breach_types       String[]        @default([])

  incident Incident? @relation(fields: [incident_id], references: [incident_id])
  vehicle  Vehicle   @relation(fields: [vehicle_id], references: [vehicle_id])

  @@index([image_url_front, image_url_rear])
  @@map("overcapacity_violations")
}

model Overspeeding_Violations {
  overspeeding_id String          @id @default(uuid()) @db.Uuid
  incident_id     String?         @unique @default(uuid()) @db.Uuid
  vehicle_id      String          @default(uuid()) @db.Uuid
  status          ViolationStatus @default(PENDING)
  remarks         String?
  detected_at     DateTime        @default(now()) @db.Timestamp()
  created_at      DateTime        @default(now()) @db.Timestamp()
  updated_at      DateTime        @default(now()) @updatedAt @db.Timestamp()
  location        Json?
  speed_detected  Float?          @db.Real

  incident Incident? @relation(fields: [incident_id], references: [incident_id])
  vehicle  Vehicle   @relation(fields: [vehicle_id], references: [vehicle_id])

  @@map("overspeeding_violations")
}

//////////////////////////////////////////////////////
// ETA SYSTEM
//////////////////////////////////////////////////////

model ETA_Request {
  request_id                 String   @id @default(uuid()) @db.Uuid
  commuter_id                String   @db.Uuid
  vehicle_id                 String   @db.Uuid
  trip_id                    String   @db.Uuid
  request_location_latitude  Float
  request_location_longitude Float
  ETA                        Float
  distance_value             Float
  timestamp                  DateTime

  vehicle  Vehicle  @relation(fields: [vehicle_id], references: [vehicle_id])
  trip     Trip     @relation(fields: [trip_id], references: [trip_id])
  commuter Commuter @relation(fields: [commuter_id], references: [commuter_id])

  @@map("eta_request")
}

model Commuter {
  commuter_id String @id @default(uuid()) @db.Uuid

  etaRequests ETA_Request[]

  @@map("commuter")
}